{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NadlanFileObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/__ROOT_PREFIX__*"
    },
    {
      "Sid": "NadlanListOwnFolder",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": ["__ROOT_PREFIX__*"] } }
    },
    {
      "Sid": "NoWritesToImporterDownloads",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::__BUCKET__/__ROOT_PREFIX___downloads/*"
    }
  ]
}
