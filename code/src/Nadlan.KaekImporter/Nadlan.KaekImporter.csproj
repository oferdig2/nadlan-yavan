<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Customer-side tool: opens gis.ktimanet.gr in a visible browser and imports the parcels in the user's view
    into Nadlan through its HTTP API. Standalone on purpose (no server projects) so it can be published per
    platform; install packages for Windows and Mac: code/installer/Publish-KaekImporter.ps1
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NadlanKaekImporter</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Show "1.0.0" to users (Apps list, logs), not "1.0.0+<git commit>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.50.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Browser\panel.js" LogicalName="panel.js" />
  </ItemGroup>

</Project>
